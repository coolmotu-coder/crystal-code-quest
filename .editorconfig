# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# 2 space indentation
[*.{js,ts,tsx,json,yaml,yml}]
indent_style = space
indent_size = 2

# 4 space indentation for HTML
[*.{html,xml}]
indent_style = space
indent_size = 4

# Match files for specific languages
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# TypeScript/JavaScript specific
[{package.json,tsconfig.json}]
indent_style = space
indent_size = 2

# CSS/SCSS
[*.css,*.scss]
indent_style = space
indent_size = 2

# Python
[*.py]
indent_style = space
indent_size = 4
