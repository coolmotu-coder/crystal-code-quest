{
  "name": "the-crystal-adventure",
  "version": "0.1.0",
  "private": true,
  "description": "A private, home-network web game for two children in one household",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=apps/server",
    "test": "npm run test --workspaces",
    "test:web": "npm run test --workspace=apps/web",
    "test:server": "npm run test --workspace=apps/server",
    "lint": "npm run lint --workspaces",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint:server": "npm run lint --workspace=apps/server",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "prettier": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0"
  },
  "engines": {
    "node": ">=20.14.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.0.0"
}
